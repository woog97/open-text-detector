OTD_DATA_DIR=.data
OTD_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OTD_WORKER_ENABLED=true
OTD_ALLOW_LOCAL_MODEL_ENDPOINTS=false
# Leave unset until Hugging Face has approved access to both repositories.
# HF_TOKEN=
# Optional explicit compute device: cpu, mps, cuda
OTD_MODEL_DEVICE=auto

# Optional parent directory for the downloaded Qwen checkpoint:
# OTD_MODEL_DIR=/absolute/path/to/models

# Lossless findings objects: local for development; s3 for R2/AWS/compatible storage.
OTD_RESULT_STORAGE=local
# OTD_RESULT_STORAGE=s3
# OTD_RESULT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OTD_RESULT_S3_BUCKET=open-text-detector-findings
# OTD_RESULT_S3_REGION=auto
# Set credentials in the deployment secret manager, never in frontend variables.
# OTD_RESULT_S3_ACCESS_KEY=
# OTD_RESULT_S3_SECRET_KEY=
OTD_RESULT_S3_PREFIX=findings/v1
OTD_RESULT_CACHE_BYTES=33554432
