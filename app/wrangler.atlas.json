{
  "name": "open-text-detector",
  "account_id": "6147916993a1cbfa4e3898aaeed27ae3",
  "main": "atlas-cloud/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    {"pattern": "opentextdetector.com", "custom_domain": true},
    {"pattern": "www.opentextdetector.com", "custom_domain": true}
  ],
  "assets": {
    "directory": "./dist-atlas",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/backend/*",
      "/workbench",
      "/private",
      "/private/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "pangram-paper-atlas"
    }
  ],
  "observability": {
    "enabled": false
  }
}
