{
  "manifest_version": 3,
  "name": "Open Text Detector for OpenReview",
  "version": "0.1.0",
  "description": "Shows the Open Text Detector AI-text share on OpenReview papers and opens the PDF with flagged sentences highlighted.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://openreview.net/*",
    "https://open-text-detector.woog09.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://openreview.net/forum*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Text Detector",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html"
      ],
      "matches": [
        "https://openreview.net/*"
      ]
    }
  ]
}
